# scope environment variables.
# Every variable is optional; defaults are shown as comments.
# Never put secrets in this file. Copy to .env.local for local overrides
# (.env.local is git-ignored).

# Absolute path to the SQLite database file.
# Default: <project>/data/localtube.db
#SCOPE_DB_PATH=

# Absolute path to the yt-dlp executable.
# Default: "yt-dlp" resolved from PATH
#SCOPE_YTDLP_PATH=

# Maximum number of simultaneous yt-dlp processes (1-8).
# Default: 2
#SCOPE_YTDLP_MAX_CONCURRENT=

# Root directory for AI job folders (materialized transcripts, reports).
# Default: <project>/data/ai-jobs
#SCOPE_AI_JOBS_ROOT=

# Absolute path to the claude CLI (Claude Code). Useful when the app's PATH
# cannot see a mise/npm install. Default: mise-managed install, then "claude"
# resolved from PATH.
#SCOPE_CLAUDE_PATH=

# Absolute path to the codex CLI. Used for both provider sign-in/status and
# AI inference. Default: "codex" resolved from PATH.
#SCOPE_CODEX_PATH=

# Absolute path to the opencode CLI. Sign-in writes OpenCode Go keys to the
# CLI's own credential store; this only overrides the binary lookup.
#SCOPE_OPENCODE_BIN=

# Total byte budget for the transcripts materialized into one AI job.
# Default: 4000000
#SCOPE_AI_MAX_MATERIALIZED_BYTES=

# Opt in to the live Codex smoke tests (uses your plan quota).
# Default: disabled
#SCOPE_AI_LIVE_TEST=1
