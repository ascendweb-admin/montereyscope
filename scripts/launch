#!/usr/bin/env bash
# scope production launcher.
#
# Ensures the production build exists, starts the server on 127.0.0.1:3000 if
# it is not already serving, waits for /api/health (which also guarantees the
# idempotent SQLite migrations have run), then opens the dashboard in the
# user's browser — in app mode when that browser supports it, otherwise as a
# normal URL.
#
# Everything is local: loopback binding only, no autostart, no services.
# Logs: logs/launcher.log (non-sensitive; see docs/desktop-launcher.md).
#
# Environment overrides:
#   SCOPE_BROWSER        executable or absolute path to force a browser,
#                        or "none" to skip opening anything
#   SCOPE_LAUNCH_TIMEOUT seconds to wait for readiness (default 60)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib.sh
source "${SCRIPT_DIR}/lib.sh"

LAUNCH_TIMEOUT="${SCOPE_LAUNCH_TIMEOUT:-${LOCALTUBE_LAUNCH_TIMEOUT:-60}}"
BROWSER_OVERRIDE="${SCOPE_BROWSER:-${LOCALTUBE_BROWSER:-}}"
NEXT_BIN="${LOCALTUBE_ROOT}/node_modules/.bin/next"
BUILD_ID_FILE="${LOCALTUBE_ROOT}/.next/BUILD_ID"

say() { printf '%s\n' "$*"; }

usage() {
  say "Usage: scripts/launch"
  say ""
  say "Starts the scope production server on ${LOCALTUBE_URL} (if not"
  say "already running) and opens it in your browser."
  say ""
  say "Environment:"
  say "  SCOPE_BROWSER=<exe|path|none>   choose/skip the browser"
  say "  SCOPE_LAUNCH_TIMEOUT=<seconds>  readiness timeout (default 60)"
}

case "${1:-}" in
  "") : ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    say "Unknown argument: $1" >&2
    usage >&2
    exit 64
    ;;
esac

mkdir -p "$LOCALTUBE_LOG_DIR" "$LOCALTUBE_RUN_DIR"
localtube_rotate_log
localtube_log "launch requested (root: ${LOCALTUBE_ROOT})"

# Desktop-launched processes may not inherit your shell's PATH, so Node from
# a version manager (mise, nix) can be invisible there. Re-add known shim
# directories when plain PATH cannot find node.
if ! command -v node >/dev/null 2>&1; then
  recovered_path=""
  for shim_dir in \
    "${HOME}/.local/share/mise/shims" \
    "${HOME}/.nix-profile/bin"; do
    if [ -x "${shim_dir}/node" ]; then
      recovered_path="${recovered_path}${shim_dir}:"
    fi
  done
  if [ -n "$recovered_path" ]; then
    export PATH="${recovered_path}${PATH}"
    localtube_log "recovered node via version-manager shims"
  else
    say "Error: node was not found on PATH and no known version-manager"
    say "shims (mise/nix) provide it. Start once from a terminal so the"
    say "environment matches, or extend PATH for your desktop session."
    exit 1
  fi
fi

# --- dependency and build gates -------------------------------------------

if [ ! -x "$NEXT_BIN" ]; then
  say "Error: Next.js binary not found at node_modules/.bin/next"
  say "Run 'npm install' in ${LOCALTUBE_ROOT} first, then retry."
  exit 1
fi

if [ ! -f "$BUILD_ID_FILE" ]; then
  say "No production build found — running 'npm run build' once..."
  localtube_log "no .next/BUILD_ID; building"
  if ! (
    cd "$LOCALTUBE_ROOT" &&
      npm run build >>"$LOCALTUBE_LOG_FILE" 2>&1
  ); then
    say "Error: production build failed."
    say "Last log lines:"
    tail -n 15 "$LOCALTUBE_LOG_FILE" | sed 's/^/  /'
    say "Full details: ${LOCALTUBE_LOG_FILE}"
    exit 1
  fi
fi

# --- start server only if not already serving ------------------------------

started_here="no"
if localtube_probe_ready; then
  say "scope is already running at ${LOCALTUBE_URL} — reusing it."
  localtube_log "server already healthy; skipping start"
  # Re-adopt the running server if we lost track of it (stale pidfile, or it
  # was started manually from this checkout). Adoption only succeeds with
  # full /proc ownership proof — see localtube_find_owned_server_pid.
  tracked_pid="$(localtube_read_pid 2>/dev/null || true)"
  if [ -z "$tracked_pid" ] || ! { localtube_pid_alive "$tracked_pid" &&
    localtube_pid_is_ours "$tracked_pid"; }; then
    adopted_pid="$(localtube_find_owned_server_pid 2>/dev/null || true)"
    if [ -n "$adopted_pid" ]; then
      printf '%s\n' "$adopted_pid" >"$LOCALTUBE_PID_FILE"
      say "Re-adopted the running server (pid ${adopted_pid}); stop/status work again."
      localtube_log "adopted existing server pid ${adopted_pid}"
    else
      say "Note: could not verify this server's PID, so 'scripts/server stop'"
      say "will refuse to stop it. Restart via the launcher to regain tracking."
      localtube_log "reuse without verified pid; leaving untracked"
    fi
  fi
else
  say "Starting scope on ${LOCALTUBE_HOST}:${LOCALTUBE_PORT} ..."
  (
    cd "$LOCALTUBE_ROOT"
    exec setsid "$NEXT_BIN" start -H "$LOCALTUBE_HOST" -p "$LOCALTUBE_PORT" \
      >>"$LOCALTUBE_LOG_FILE" 2>&1
  ) &
  server_pid=$!
  printf '%s\n' "$server_pid" >"$LOCALTUBE_PID_FILE"
  started_here="yes"
  localtube_log "server started (pid: ${server_pid})"

  # Bounded readiness wait. Reaching ready proves migrations ran because the
  # health handler opens the database (running pending migrations) before it
  # can respond.
  deadline=$((SECONDS + LAUNCH_TIMEOUT))
  until localtube_probe_ready; do
    if ! kill -0 "$server_pid" 2>/dev/null; then
      say "Error: the scope server exited during startup."
      say "Last log lines:"
      tail -n 15 "$LOCALTUBE_LOG_FILE" | sed 's/^/  /'
      say "Full details: ${LOCALTUBE_LOG_FILE}"
      localtube_log "server pid ${server_pid} exited before becoming ready"
      rm -f "$LOCALTUBE_PID_FILE"
      exit 1
    fi
    if [ "$SECONDS" -ge "$deadline" ]; then
      say "Error: server did not become ready within ${LAUNCH_TIMEOUT}s."
      say "Last log lines:"
      tail -n 15 "$LOCALTUBE_LOG_FILE" | sed 's/^/  /'
      say "It may still be starting — check '${LOCALTUBE_ROOT}/scripts/server status'."
      localtube_log "readiness timeout after ${LAUNCH_TIMEOUT}s"
      exit 1
    fi
    sleep 0.5
  done
  say "Server is ready (database migrations applied)."
fi

# --- open in the user's browser --------------------------------------------

open_browser() {
  local url="$1"
  local bin=""

  # Explicit override always wins; "none" is useful for headless/scripted use.
  if [ -n "$BROWSER_OVERRIDE" ]; then
    case $BROWSER_OVERRIDE in
      none)
        say "SCOPE_BROWSER=none — not opening a browser."
        return 0
        ;;
      *)
        bin="$(command -v "$BROWSER_OVERRIDE" 2>/dev/null || true)"
        if [ -z "$bin" ]; then
          say "Warning: SCOPE_BROWSER='${BROWSER_OVERRIDE}' not found; skipping open."
          localtube_log "override browser not found: ${BROWSER_OVERRIDE}"
          return 0
        fi
        case "$(basename "$bin")" in
          *google-chrome* | *chromium* | *brave* | *microsoft-edge* | *vivaldi* | *opera* | *helium*)
            setsid "$bin" --app="$url" >/dev/null 2>&1 &
            say "Opened ${url} in app mode (${bin})."
            localtube_log "opened app mode via ${bin} (override)"
            ;;
          *)
            setsid "$bin" "$url" >/dev/null 2>&1 &
            say "Opened ${url} via ${bin}."
            localtube_log "opened ${bin} (override)"
            ;;
        esac
        return 0
        ;;
    esac
  fi

  local desktop_id desktop_file exec_cmd
  desktop_id="$(xdg-settings get default-web-browser 2>/dev/null | tr -d '\r\n' || true)"
  if [ -z "$desktop_id" ]; then
    fallback_open
    return 0
  fi

  desktop_file=""
  for candidate in \
    "${XDG_DATA_HOME:-$HOME/.local/share}/applications/${desktop_id}" \
    "$HOME/.nix-profile/share/applications/${desktop_id}" \
    "/usr/share/applications/${desktop_id}"; do
    if [ -f "$candidate" ]; then
      desktop_file="$candidate"
      break
    fi
  done

  if [ -z "$desktop_file" ]; then
    fallback_open
    return 0
  fi

  # First token of Exec= with freedesktop field codes stripped.
  exec_cmd="$(sed -n 's/^Exec=\([^ ;]*\).*/\1/p' "$desktop_file" | head -n 1)"
  if [ -z "$exec_cmd" ] || ! command -v "$exec_cmd" >/dev/null 2>&1; then
    fallback_open
    return 0
  fi

  case $exec_cmd in
    *google-chrome* | *chromium* | *brave* | *microsoft-edge* | *vivaldi* | *opera* | *helium*)
      setsid "$exec_cmd" --app="$url" >/dev/null 2>&1 &
      say "Opened ${url} in app mode (${exec_cmd})."
      localtube_log "opened app mode via ${exec_cmd}"
      ;;
    *)
      # Firefox and friends no longer support --app; open as a normal URL.
      fallback_open
      ;;
  esac
}

fallback_open() {
  if command -v xdg-open >/dev/null 2>&1; then
    setsid xdg-open "$LOCALTUBE_URL" >/dev/null 2>&1 &
    say "Browser has no app mode; opened ${LOCALTUBE_URL} normally."
    localtube_log "fallback open via xdg-open"
    return 0
  fi
  say "Could not find a way to open a browser; open ${LOCALTUBE_URL} manually."
  localtube_log "no opener found; manual open required"
  return 0
}

open_browser "$LOCALTUBE_URL"

# Report degraded-but-serving state so missing yt-dlp is visible immediately.
if localtube_probe_healthy; then
  localtube_log "launch complete (healthy)"
else
  say "Note: server is up but reports degraded health (see Settings inside the app;"
  say "usually yt-dlp was not found on PATH)."
  localtube_log "launch complete (degraded)"
fi
say "Dashboard: ${LOCALTUBE_URL}"
[ "$started_here" = yes ] && say "(stop later with: ${LOCALTUBE_ROOT}/scripts/server stop)"
exit 0
